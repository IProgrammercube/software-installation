pipeline {

    agent any

    parameters {
        file(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Read CSV') {

            steps {

                script {

                    sh '''
                        echo "Workspace:"
                        pwd

                        echo "Files:"
                        ls -la
                    '''

                    def csv = sh(
                        script: "cat '${params.CSV_FILE}'",
                        returnStdout: true
                    ).trim()

                    def assignList = []

                    csv.split('\n').drop(1).each { line ->

                        if (line.trim()) {
                            assignList.add(line.trim())
                        }
                    }

                    echo "Assign List: ${assignList}"

                    assignList.each { assign ->
                        echo "Assign: ${assign}"
                    }
                }
            }
        }
    }
}
