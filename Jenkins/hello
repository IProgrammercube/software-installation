pipeline {

    agent any

    parameters {
        file(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Read CSV') {

            steps {

                script {

                    // Read CSV
                    def csv = readFile params.CSV_FILE

                    // Create List
                    def assignList = []

                    csv.split('\n').drop(1).each { line ->

                        if (line.trim()) {
                            assignList.add(line.trim())
                        }
                    }

                    // Print List
                    echo "Assign List: ${assignList}"

                    // Print each value
                    assignList.each { assign ->
                        echo "Assign: ${assign}"
                    }
                }
            }
        }
    }
}
