pipeline {

    agent any

    parameters {
        file(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Check Upload') {

            steps {

                script {

                    echo "CSV parameter:"
                    echo "${params.CSV_FILE}"

                    sh '''
                        echo "Workspace:"
                        pwd

                        echo "Workspace files:"
                        ls -la
                    '''
                }
            }
        }
    }
}
