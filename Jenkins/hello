pipeline {
    agent any
    stages {
        stage('Load Env File') {
            steps {
                script {
                    // Read .env file as properties
                    def props = readProperties file: 'Jenkins/.env'

                    // Wrap properties into Jenkins environment safely
                    withEnv(props.collect { k,v -> "${k}=${v}" }) {
                        echo "App Name: ${env.APP_NAME}"
                        echo "App Environment: ${env.APP_ENV}"
                        echo "App Port: ${env.APP_PORT}"
                        echo "Database User: ${env.DB_USER}"
                        echo "Debug Mode: ${env.DEBUG}"
                        echo "AWS Region: ${env.AWS_REGION}"
                        echo "Build Number: ${env.BUILD_NUMBER}"
                    }
                }
            }
        }
        stage('Conditional Logic') {
            steps {
                script {
                    // Boolean check
                    if (env.DEBUG == 'true') {
                        echo "Debugging is enabled"
                    } else {
                        echo "Debugging is disabled"
                    }

                    // Safe integer conversion
                    def maxConn = env.MAX_CONNECTIONS ? env.MAX_CONNECTIONS.toInteger() : 0
                    if (maxConn > 50) {
                        echo "High connection limit: ${maxConn}"
                    } else {
                        echo "Low connection limit: ${maxConn}"
                    }
                }
            }
        }
    }
}
