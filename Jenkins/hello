pipeline {

    agent any

    parameters {
        file(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Read CSV') {

            steps {

                withFileParameter('CSV_FILE') {

                    sh '''
                        echo "Workspace:"
                        pwd

                        echo "Files:"
                        ls -la

                        echo "CSV Content:"
                        cat "$CSV_FILE"
                    '''
                }
            }
        }
    }
}
