pipeline {

    agent any

    parameters {

        extendedChoice(
            name: 'ENVIRONMENTS',
            type: 'PT_CHECKBOX',
            multiSelectDelimiter: ',',
            value: 'A,B,C',
            description: 'Select environments'
        )
    }

    stages {

        stage('Print Selection') {
            steps {
                echo "Selected environments: ${params.ENVIRONMENTS}"

                script {
                    def selected = params.ENVIRONMENTS.split(',')

                    selected.each { environment ->
                        echo "Selected: ${environment}"
                    }
                }
            }
        }
    }
}
