pipeline {

    agent any

    stages {

        stage('Select Environment') {

            steps {

                script {

                    // Read YAML
                    def config = readYaml file: 'Jenkins/value.yaml'

                    // Get environments list
                    def environments = config.environments

                    // Create checkboxes
                    def checkboxes = []

                    environments.each { environment ->

                        checkboxes.add(
                            booleanParam(
                                name: environment,
                                defaultValue: false,
                                description: "Select ${environment}"
                            )
                        )
                    }

                    // Select
                    def selection = input(
                        message: 'Select Environments',
                        parameters: checkboxes
                    )

                    // Print selection
                    echo "Selected Environments: ${selection}"
                }
            }
        }
    }
}
