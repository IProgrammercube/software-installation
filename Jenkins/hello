pipeline {

    agent any

    parameters {

        fileParam(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Read CSV') {

            steps {

                script {

                    echo "CSV file: ${params.CSV_FILE}"

                    def csv = readFile(params.CSV_FILE)

                    echo "CSV Content:"
                    echo csv

                    def assignList = []

                    csv.split('\n').drop(1).each { line ->
                        if (line.trim()) {
                            assignList.add(line.trim())
                        }
                    }

                    echo "Assign List: ${assignList}"

                    assignList.each { assign ->
                        echo "Assign: ${assign}"
                    }
                }
            }
        }
    }
}
