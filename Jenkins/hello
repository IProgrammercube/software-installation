pipeline {
    agent any
    stages {
        stage('Load Env File') {
            steps {
                script {
                    // Adjust path to match where .env actually is
                    sh "set -a && source Jenkins/.env && set +a"
                    
                    // Print values
                    echo "App Name: ${env.APP_NAME}"
                    echo "App Environment: ${env.APP_ENV}"
                    echo "App Port: ${env.APP_PORT}"
                    echo "Database User: ${env.DB_USER}"
                    echo "Debug Mode: ${env.DEBUG}"
                    echo "AWS Region: ${env.AWS_REGION}"
                    echo "Build Number: ${env.BUILD_NUMBER}"
                }
            }
        }
        stage('Conditional Logic') {
            steps {
                script {
                    if (env.DEBUG == 'true') {
                        echo "Debugging is enabled"
                    } else {
                        echo "Debugging is disabled"
                    }

                    def maxConn = env.MAX_CONNECTIONS.toInteger()
                    if (maxConn > 50) {
                        echo "High connection limit: ${maxConn}"
                    } else {
                        echo "Low connection limit: ${maxConn}"
                    }
                }
            }
        }
    }
}
