pipeline {

    agent any

    stages {

        stage('Read YAML') {

            steps {

                script {

                    // Read value.yaml
                    def config = readYaml file: 'value.yaml'

                    // Get environments list
                    def environments = config.environments

                    echo "Available environments: ${environments}"

                    // Create checkbox parameters
                    def checkboxes = []

                    environments.each { environment ->

                        checkboxes.add(
                            booleanParam(
                                name: environment,
                                defaultValue: false,
                                description: "Select ${environment}"
                            )
                        )
                    }

                    // Show selection screen
                    def selection = input(
                        message: 'Select Environments',
                        parameters: checkboxes
                    )

                    // Create selected list
                    def selectedEnvironments = []

                    selection.each { environment, selected ->

                        if (selected) {
                            selectedEnvironments.add(environment)
                        }
                    }

                    echo "Selected Environments: ${selectedEnvironments}"

                    selectedEnvironments.each { environment ->
                        echo "Selected: ${environment}"
                    }
                }
            }
        }
    }
}
