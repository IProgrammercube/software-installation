pipeline {

    agent any

    parameters {

        file(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Read CSV') {

            steps {

                script {

                    echo "CSV File: ${params.CSV_FILE}"

                    sh """
                        echo "CSV Content:"
                        cat "${params.CSV_FILE}"
                    """
                }
            }
        }
    }
}
