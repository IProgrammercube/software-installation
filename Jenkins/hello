pipeline {

    agent any

    parameters {

        file(
            name: 'CSV_FILE',
            description: 'Upload CSV file'
        )
    }

    stages {

        stage('Read CSV') {

            steps {

                script {

                    echo "Reading CSV file..."

                    sh '''
                        echo "CSV Content:"
                        cat "$CSV_FILE"
                    '''
                }
            }
        }
    }
}
