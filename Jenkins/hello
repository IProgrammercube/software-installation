pipeline {
    agent any
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'], description: 'Select environment')
    }
    stages {
        stage('Load Env File') {
            steps {
                script {
                    // Pick the right env file based on parameter
                    def envFile = ".env.${params.ENVIRONMENT}"
                    
                    // Load all variables into Jenkins environment
                    sh "set -a && source ${envFile} && set +a"
                    
                    // Print values (string, integer, boolean)
                    echo "App Name: ${env.APP_NAME}"          // String
                    echo "App Environment: ${env.APP_ENV}"   // String
                    echo "App Port: ${env.APP_PORT}"         // Integer (still string here)
                    echo "Debug Mode: ${env.DEBUG}"          // Boolean (string 'true'/'false')
                    echo "AWS Region: ${env.AWS_REGION}"     // String
                    echo "Build Number: ${env.BUILD_NUMBER}" // Integer (string)
                }
            }
        }
        stage('Conditional Logic') {
            steps {
                script {
                    // Example: use boolean flag
                    if (env.DEBUG == 'true') {
                        echo "Debugging is enabled"
                    } else {
                        echo "Debugging is disabled"
                    }

                    // Example: use integer conversion
                    def maxConn = env.MAX_CONNECTIONS.toInteger()
                    if (maxConn > 50) {
                        echo "High connection limit: ${maxConn}"
                    } else {
                        echo "Low connection limit: ${maxConn}"
                    }
                }
            }
        }
    }
}
