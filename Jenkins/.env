# String values
APP_NAME=myapp
APP_ENV=development
DB_USER=myapp_user
DB_PASSWORD=supersecret

# Integer values (still stored as strings, converted later in code)
APP_PORT=8080
DB_PORT=5432
MAX_CONNECTIONS=100

# Boolean values (true/false flags)
DEBUG=true
ENABLE_CACHE=false
USE_SSL=true

# Cloud/Service configs
AWS_REGION=ap-south-1
S3_BUCKET=myapp-bucket

# Pipeline flags
DEPLOY_ENV=prod
BUILD_NUMBER=42
